{
  "dashboard": {
    "title": "Eventify Platform - Comprehensive Observability Dashboard",
    "tags": ["eventify", "microservices", "observability"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "API Request Rate (req/s)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m])) by (service)",
            "legendFormat": "{{service}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "API Error Rate (%)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_errors_total[5m])) / sum(rate(http_requests_total[5m])) * 100",
            "legendFormat": "Error Rate %"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "API Request Latency (p95, p99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))",
            "legendFormat": "p95 - {{service}}"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, service))",
            "legendFormat": "p99 - {{service}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Active HTTP Requests (Concurrency)",
        "type": "graph",
        "targets": [
          {
            "expr": "http_active_requests",
            "legendFormat": "{{service}} - {{method}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Service-Level Operations: Event Service",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(event_operations_total{status=\"success\"}[5m])",
            "legendFormat": "{{operation}} - success"
          },
          {
            "expr": "rate(event_operations_total{status=\"failure\"}[5m])",
            "legendFormat": "{{operation}} - failure"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Service-Level Latency: Event Operations",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(event_operation_duration_seconds_bucket[5m])) by (le, operation))",
            "legendFormat": "p95 - {{operation}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 7,
        "title": "Dependency: MongoDB Operation Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(mongodb_operation_duration_seconds_bucket[5m])) by (le, operation, collection))",
            "legendFormat": "p95 - {{operation}} on {{collection}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
      },
      {
        "id": 8,
        "title": "Dependency: MongoDB Errors",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(mongodb_operation_errors_total[5m])) by (operation, error_type)",
            "legendFormat": "{{operation}} - {{error_type}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      },
      {
        "id": 9,
        "title": "Dependency: Redis Cache Hit/Miss Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(cache_hits_total[5m])) / (sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])))",
            "legendFormat": "Cache Hit Rate"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32}
      },
      {
        "id": 10,
        "title": "Dependency: Redis Operation Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(cache_operation_duration_seconds_bucket[5m])) by (le, operation))",
            "legendFormat": "p95 - {{operation}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32}
      },
      {
        "id": 11,
        "title": "Dependency: RabbitMQ Publish Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(rabbitmq_publish_duration_seconds_bucket[5m])) by (le, routing_key))",
            "legendFormat": "p95 - {{routing_key}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40}
      },
      {
        "id": 12,
        "title": "Dependency: RabbitMQ Message Processing",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(rabbitmq_messages_processed_total[5m])) by (routing_key, status)",
            "legendFormat": "{{routing_key}} - {{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40}
      },
      {
        "id": 13,
        "title": "Service-Level: Authentication Operations",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(auth_operations_total[5m])",
            "legendFormat": "{{operation}} - {{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 48}
      },
      {
        "id": 14,
        "title": "Service-Level: Notification Operations",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(notification_send_operations_total[5m])",
            "legendFormat": "{{notification_type}} - {{status}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 48}
      },
      {
        "id": 15,
        "title": "Business Metrics: Events & RSVPs Created",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(events_created_total[5m])",
            "legendFormat": "Events Created/s"
          },
          {
            "expr": "rate(rsvps_created_total[5m])",
            "legendFormat": "RSVPs Created/s"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 56}
      },
      {
        "id": 16,
        "title": "System: CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU Usage % - {{instance}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56}
      },
      {
        "id": 17,
        "title": "System: Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
            "legendFormat": "Memory Usage % - {{instance}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 64}
      },
      {
        "id": 18,
        "title": "Container: CPU Usage per Container",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{image!=\"\"}[5m])",
            "legendFormat": "{{name}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 64}
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-15m",
      "to": "now"
    }
  }
}
